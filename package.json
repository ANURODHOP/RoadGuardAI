{
  "name": "roadguard",
  "version": "1.0.0",
  "private": true,
  "description": "RoadGuard — Offline AI-Powered Road Damage Detection & Complaint Management",
  "workspaces": [
    "apps/mobile",
    "apps/admin"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-native-worklets": "0.13.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native-worklets": "0.13.0"
  },
  "scripts": {
    "mobile": "npm --prefix apps/mobile start",
    "mobile:android": "npm --prefix apps/mobile run android",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:test": "npm --prefix apps/mobile test",
    "test:preprocessing": "npm --prefix apps/mobile test",
    "test:dataset": "node --test ml/scripts/__tests__/test_dataset_audit.mjs",
    "test:stage21": "node --test ml/scripts/__tests__/test_stage21.mjs",
    "test:stage3": "node --test ml/scripts/__tests__/test_stage3.mjs",
    "test:pipeline": "node --test ml/scripts/__tests__/test_dataset_pipeline.mjs",
    "admin": "npm --prefix apps/admin run dev",
    "admin:build": "npm --prefix apps/admin run build",
    "admin:start": "npm --prefix apps/admin run start",
    "admin:create-user": "node scripts/create_admin.js",
    "test:ml": "python ml/scripts/test_inference.py"
  },
  "keywords": [
    "civic-tech",
    "pothole-detection",
    "yolov8",
    "onnx",
    "react-native",
    "nextjs",
    "supabase"
  ],
  "author": "RoadGuard Engineering Team",
  "license": "MIT"
}
