# ============================================================
# RoadGuard — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Supabase (Mobile App & Admin Web) ──────────────────────
# Found at: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase Service Role Key (NEVER expose in frontend) ────
# Used only in Supabase Edge Functions and Next.js API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Next.js Admin Dashboard ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Maps ────────────────────────────────────────────────────
# OpenStreetMap tiles used by default — no key required.
# If you switch to Google Maps, add the Android key here:
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-android-key

# ── Street-level Imagery (Optional) ─────────────────────────
# Leave blank to disable street-level evidence feature.
# EXPO_PUBLIC_MAPILLARY_ACCESS_TOKEN=your-mapillary-client-token

# ── ML Model ─────────────────────────────────────────────────
# Path is relative to apps/mobile/assets/models/
# Default: pothole_yolov8n.onnx  (bundled with the app)
EXPO_PUBLIC_MODEL_FILENAME=pothole_yolov8n.onnx
EXPO_PUBLIC_DETECTION_CONFIDENCE_THRESHOLD=0.40
EXPO_PUBLIC_UNCERTAIN_CONFIDENCE_THRESHOLD=0.25

# ── Duplicate Detection ──────────────────────────────────────
EXPO_PUBLIC_DUPLICATE_RADIUS_METERS=30

# ── Admin Dashboard ──────────────────────────────────────────
# The admin role is assigned directly in the Supabase database.
# See: supabase/seed.sql for the setup command.
